<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.autcion.auction_back.marketpage.DAO.MarketItemMapper">

    <!-- 1) 물품(정찰) 구매 가능 리스트 조회 -->
    <select id="marketItemList" resultType="com.autcion.auction_back.marketpage.DTO.MarketItemDTO">
        SELECT item_id, title, description, price, status, market_id
        FROM market_items
        WHERE status = 'available'
        AND market_id = #{marketId}
    </select>

    <!-- 2) 물품(정찰) 상세 정보 조회 -->
    <select id="getMarketItemDetail" parameterType="int" resultType="com.autcion.auction_back.marketpage.DTO.MarketItemDTO">
        <!-- SELECT item_id, title, description, price, status -->
        SELECT *
        FROM market_items
        WHERE item_id = #{itemId}
    </select>

    <!-- 3) 물품(정찰) 등록 -->
    <insert id="createMarketItem" parameterType="com.autcion.auction_back.marketpage.DTO.MarketItemDTO">
        INSERT INTO market_items (title, description, price, status, market_id)
        VALUES (#{title}, #{description}, #{price}, #{status}, #{market_id})
    </insert>

    <!-- 4) 물품(정찰) 상세 정보 수정 -->
    <update id="updateMarketItem" parameterType="com.autcion.auction_back.marketpage.DTO.MarketItemDTO">
        UPDATE market_items
        SET title = #{title},
            description = #{description},
            price = #{price}
        WHERE item_id = #{item_id}
    </update>

    <!-- 5) 물품(정찰) 삭제 -->
    <delete id="deleteMarketItem" parameterType="int">
        DELETE FROM market_items
        WHERE item_id = #{itemId}
    </delete>

    <!-- 6) 물품(정찰) 구매 (status -> sold_out) -->
    <update id="purchaseMarketItem" parameterType="int">
        UPDATE market_items
        SET status = 'sold_out'
        WHERE item_id = #{itemId}
    </update>

    <!-- ========== Market Image CRUD ========== -->

    <!-- 16) 물품(정찰) 이미지 저장 -->
    <insert id="insertMarketImage" parameterType="com.autcion.auction_back.marketpage.DTO.MarketImageDTO">
        INSERT INTO market_image (item_id, image_url, created_at)
        VALUES (#{item_id}, #{image_url}, NOW())
    </insert>

    <!-- 18) 물품(정찰) 이미지 조회 -->
    <select id="getMarketImagesByItemId" parameterType="int" resultType="com.autcion.auction_back.marketpage.DTO.MarketImageDTO">
        SELECT image_id, item_id, image_url, created_at, updated_at
        FROM market_image
        WHERE item_id = #{itemId}
    </select>

    <!-- 20) 물품(정찰) 이미지 수정 -->
    <update id="updateMarketImage" parameterType="com.autcion.auction_back.marketpage.DTO.MarketImageDTO">
        UPDATE market_image
        SET image_url = #{image_url},
            updated_at = NOW()
        WHERE image_id = #{image_id}
    </update>

    <!-- 22) 물품(정찰) 이미지 삭제 -->
    <delete id="deleteMarketImage" parameterType="long">
        DELETE FROM market_image
        WHERE image_id = #{imageId}
    </delete>

</mapper>
